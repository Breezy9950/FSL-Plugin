{
  "name": "FSL-Plugin",
  "version": "1.0.3",
  "description": "4KHDHub direct links with configurable source and sort preferences, plus VixSrc HLS",
  "scrapers": [
    {
      "id": "4khdhub",
      "name": "4KHDHub",
      "description": "4KHDHub direct links via search + HubCloud/Hblinks extraction, with preferred-source filtering and quality/size sorting",
      "version": "1.0.0",
      "author": "Breezy9950",
      "filename": "providers/4khdhub.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true,
      "hasSettings": true,
      "formats": ["mkv"],
      "logo": "https://www.google.com/s2/favicons?domain=4khdhub.click&sz=128",
      "contentLanguage": ["en"]
    },
    {
      "id": "maxstream-videasy",
      "name": "Videasy",
      "description": "Videasy direct HLS/DASH (MaxStream port)",
      "version": "1.0.0",
      "author": "Breezy9950",
      "filename": "providers/videasy.js",
      "supportedTypes": ["movie", "tv"],
      "enabled": true,
      "hasSettings": false,
      "formats": ["mkv", "mp4"],
      "logo": "https://www.google.com/s2/favicons?domain=player.videasy.to&sz=128",
      "contentLanguage": ["en"]
    }
  ]
}
